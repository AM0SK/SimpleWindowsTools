<Window x:Class="SimpleWindowsTools.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        Title="Simple Windows Tools overlay">
    <!-- Pill like the old AHK overlay, in the design-system colors. Margin leaves room for the shadow. -->
    <Grid Margin="16">
        <Border x:Name="Pill" SizeChanged="Pill_SizeChanged" Opacity="0"
                Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
            <Grid>
                <Border x:Name="Glow" Background="{DynamicResource TopGlow}" />
                <TextBlock x:Name="Label" Text="EN" Margin="28,10" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="18"
                           Foreground="{DynamicResource Ink}" />
            </Grid>
        </Border>
    </Grid>
</Window>
