<!--
  Dark theme colors of the app's design system.
  The only theme (a light one existed in 0.5–0.6.2 and was removed). Colors are used as {DynamicResource …}.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Surface0Color">#0E0D12</Color>
    <Color x:Key="Surface100Color">#17161D</Color>
    <Color x:Key="Surface200Color">#1F1E28</Color>
    <Color x:Key="BorderColor">#2B2935</Color>
    <Color x:Key="InkColor">#F2F1F4</Color>
    <Color x:Key="InkMutedColor">#9B98A9</Color>
    <Color x:Key="InkFaintColor">#605E6D</Color>
    <Color x:Key="AccentStartColor">#6D5DF6</Color>
    <Color x:Key="AccentEndColor">#4C8DFF</Color>
    <Color x:Key="AccentSolidColor">#9C8CFF</Color>
    <Color x:Key="SuccessColor">#3DD68C</Color>
    <Color x:Key="WarningColor">#F2B84B</Color>
    <Color x:Key="CriticalColor">#F2555A</Color>

    <SolidColorBrush x:Key="Surface0" Color="#0E0D12" />
    <SolidColorBrush x:Key="Surface100" Color="#17161D" />
    <SolidColorBrush x:Key="Surface200" Color="#1F1E28" />
    <SolidColorBrush x:Key="Border" Color="#2B2935" />
    <SolidColorBrush x:Key="Ink" Color="#F2F1F4" />
    <SolidColorBrush x:Key="InkMuted" Color="#9B98A9" />
    <SolidColorBrush x:Key="InkFaint" Color="#605E6D" />
    <SolidColorBrush x:Key="AccentSolid" Color="#9C8CFF" />
    <SolidColorBrush x:Key="Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Warning" Color="#F2B84B" />
    <SolidColorBrush x:Key="Critical" Color="#F2555A" />

    <!-- Glass panel: surface-100 at 60% over the page background -->
    <SolidColorBrush x:Key="Glass" Color="#9917161D" />
    <SolidColorBrush x:Key="Hairline" Color="#0FFFFFFF" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6D5DF6" />
        <GradientStop Offset="1" Color="#4C8DFF" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="TopGlow" Center="0.5,-0.25" GradientOrigin="0.5,-0.25" RadiusX="0.75" RadiusY="0.7">
        <GradientStop Offset="0" Color="#266D5DF6" />
        <GradientStop Offset="0.35" Color="#176D5DF6" />
        <GradientStop Offset="0.65" Color="#0B6D5DF6" />
        <GradientStop Offset="1" Color="#006D5DF6" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="PillNeutralBg" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PillNeutralRing" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PillAccentBg" Color="#266D5DF6" />
    <SolidColorBrush x:Key="PillAccentRing" Color="#406D5DF6" />
    <SolidColorBrush x:Key="PillWarnBg" Color="#1FF2B84B" />
    <SolidColorBrush x:Key="PillWarnRing" Color="#40F2B84B" />
    <SolidColorBrush x:Key="PillBadBg" Color="#1FF2555A" />
    <SolidColorBrush x:Key="PillBadRing" Color="#40F2555A" />

    <!-- Hover / press veils on buttons, accordion background and hover -->
    <SolidColorBrush x:Key="Veil" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="VeilPressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="AccordionBg" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="AccordionHover" Color="#0DFFFFFF" />

    <!-- Floating panels: layout pill, screenshot toolbar and labels -->
    <SolidColorBrush x:Key="OverlayBg" Color="#F517161D" />
    <SolidColorBrush x:Key="ToolbarBg" Color="#F217161D" />
    <SolidColorBrush x:Key="LabelBg" Color="#E617161D" />
</ResourceDictionary>
